// Generated by scripts/upstream_reference.py --update.
// Verbatim pinned upstream distance kernel, 40 configurations.

///|
test "distance projection matches upstream C++ in 40 configurations" {
  {
    let w = World::new(
      config=Config::new(
        gravity=Vec2::new(0.0, 0.0),
        substeps=1,
        iterations=1,
        damping=0.0,
      ),
    )
    let a = w.add_particle(Vec2::new(0.0, -0.0), mass=0.0)
    let b = w.add_particle(Vec2::new(0.5, 0.4), mass=0.7)
    ignore(w.add_distance(a, b, rest_length=0.2, compliance=0.0))
    ignore(w.step(0.01))
    assert_true((w.position(a).x - 0.0).abs() < 0.000000001)
    assert_true((w.position(a).y - 0.0).abs() < 0.000000001)
    assert_true((w.position(b).x - 0.1561737618886061).abs() < 0.000000001)
    assert_true((w.position(b).y - 0.12493900951088488).abs() < 0.000000001)
  }
